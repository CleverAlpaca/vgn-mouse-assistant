{
  "name": "vgn-mouse-assistant",
  "productName": "VGN 鼠标助手",
  "version": "1.0.0",
  "description": "VGN/ATK/VXE 无线鼠标电量监控与参数设置（苹果风格）",
  "main": "src/main.js",
  "author": "local",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "bundle": "node scripts/bundle-openmouse.mjs",
    "dist": "npm run bundle && electron-builder"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@openmouse/protocol": "^0.46.0"
  },
  "build": {
    "appId": "com.local.vgn-mouse-assistant",
    "productName": "VGN 鼠标助手",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
